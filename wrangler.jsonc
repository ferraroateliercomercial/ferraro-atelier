// Publicação na Cloudflare como Worker com arquivos estáticos (o caminho "Workers" do painel).
// Comando de build: bash scripts/build.sh · comando de deploy: npx wrangler deploy
// Na Cloudflare Pages este arquivo é ignorado (lá vale: build "bash scripts/build.sh", saída "dist").
{
  "name": "ferraro-atelier",
  "compatibility_date": "2025-09-01",
  // endereço público em ferraro-atelier.<conta>.workers.dev (e links de prévia de cada versão)
  "workers_dev": true,
  "preview_urls": true,
  // o Worker só roda nos pedidos do filme (respostas por partes); o resto vem direto dos arquivos estáticos
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/film/*"]
  }
}
